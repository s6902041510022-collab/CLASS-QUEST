{
  "name": "class-quest",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check": "node scripts/check.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --import ./scripts/register-ts.mjs --test-reporter=tap --test scripts/api-guards.test.mjs scripts/auth-cache.test.mjs scripts/db-env-names.test.mjs scripts/db-kv.test.mjs scripts/db-precedence.test.mjs scripts/mission-tasks.test.mjs scripts/no-pin-in-ui.test.mjs scripts/seed-kv.test.mjs scripts/test-inventory.test.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "seed": "node data/seed-all.mjs",
    "seed:kv": "node data/seed-kv.mjs",
    "seed:firestore": "node data/seed-firestore.mjs",
    "db:upload:firestore": "node data/seed-firestore.mjs",
    "serve:public": "node scripts/serve-public.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "firebase-admin": "^14.5.0",
    "next": "14.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "socket.io": "^4.7.4",
    "socket.io-client": "^4.7.4",
    "tailwind-merge": "^2.2.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^9.0.8",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-config-next": "14.2.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.0"
  }
