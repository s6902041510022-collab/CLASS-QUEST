# ===== ฐานข้อมูล =====
# CLASS QUEST เลือกที่เก็บข้อมูลอัตโนมัติ
#
# 1) ไม่ตั้งค่าอะไรเลย  -> เก็บเป็นไฟล์ data/db.json (เหมาะกับคอมพิวเตอร์ครู / dev)
# 2) ตั้งค่า 2 ตัวแปรข้างล่าง -> เก็บใน Redis (จำเป็นตอน deploy บน Vercel)

# --- Vercel KV / Upstash Redis (ต้องมีถ้าจะ deploy บน Vercel) ---
# สร้างได้ที่ vercel.com > Storage > Create Database > KV (Upstash Redis)
# แล้วเอาค่ามากาวางใน Project Settings > Environment Variables
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ชื่อ key ใน Redis (ถ้าเว้นว่างจะใช้ classquest:db)
KV_DB_KEY=classquest:db

# ===== อื่น ๆ =====
# PIN ครูเริ่มต้น 1234 (เปลี่ยนได้ในหน้า /teacher/settings)
