# ===== ฐานข้อมูล =====
# CLASS QUEST เลือกที่เก็บข้อมูลอัตโนมัติ ตามลำดับนี้ (ดู src/lib/db.ts จุดเลือก backend):
#
# 1) Redis (Vercel KV / Upstash Redis)  <-- ตั้งค่าน้อยที่สุด คลิก 4 ครั้งใน Vercel
# 2) Firebase Cloud Firestore
# 3) ไม่ตั้งค่าอะไรเลย -> เก็บเป็นไฟล์ data/db.json (เหมาะกับเครื่องคอมพิวเตอร์ครู / dev)
#
# ⚠️ ถ้าตั้งทั้งสองชุด Redis จะถูกใช้ก่อน (Firestore ต้องการการตั้งค่าเยอะกว่ามาก
#    เพราะต้องสร้างโปรเจกต์ Firebase + ก๊อป private key มาวางเอง)
# ⚠️ deploy บน Vercel โดยไม่ตั้ง env เลย = ใช้ไม่ได้ เพราะ filesystem ของ Vercel เป็น read-only
#    เปิด /setup ดูขั้นตอนแก้แบบคลิกต่อคลิกได้

# --- ตัวเลือก 1 (แนะนำ): Upstash Redis ---
#
# ⚠️ Vercel KV ถูกยกเลิกไปแล้ว (ธ.ค. 2024) เปลี่ยนเป็น Marketplace
#    และ "Storage" ในหน้าโปรเจกต์จะยังไม่มีถ้ายังไม่ได้ติดตั้งอะไรเลย
#
# วิธีติดตั้ง:
#   vercel.com > Integrations (sidebar ซ้าย) > Browse Marketplace
#   ค้นหา "Upstash" > Install > เลือก Free > Continue > ตั้งชื่อ > Create
#   แล้วไปที่ Products > ชื่อฐานข้อมูล > แท็บ Projects > Connect Project
#   เลือก class-quest + ติ๊ก Production และ Preview
#   แล้ว Redeploy (เปลี่ยน env แล้ว deployment ที่รันอยู่จะไม่เปลี่ยน)
#
# ⚠️⚠️ ห้ามติดตั้ง integration ชื่อ "Redis" — ตัวนั้นให้ REDIS_URL
#    ซึ่งเป็นโปรโตคอล Redis มาตรฐาน (TCP) คนละแบบกับ Upstash REST
#    ถ้าติดตั้งผิด ระบบจะไม่ใช้ และขึ้นข้อความบอกบนหน้า /setup
#
# Upstash จะใส่ค่าให้เองใน Environment Variables (ไม่ต้องพิมพ์เอง)
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_DB_KEY=classquest:db

# ชื่อสำรองที่ Upstash ใช้ตอนติดตั้งนอก Vercel — โค้ดรองรับทั้งสองชื่อ
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- ตัวเลือก 2: Firebase Cloud Firestore ---
# วิธี A: วางไฟล์ serviceAccountKey.json ไว้ที่ root โฟลเดอร์โปรเจกต์ (ง่ายที่สุด)
#   ⚠️ แต่ระบบจะเตือนในคอนโซล และหน้า /setup จะเตือนด้วย เพราะแค่วางไฟล์ทิ้งไว้
#      ก็ทำให้ระบบเลิกอ่าน data/db.json เงียบ ๆ (เกมที่ครูสร้างไว้จะดูเหมือนหาย)
# วิธี B: กำหนดตัวแปรด้านล่างนี้ใน .env.local (ส่งไป Vercel ต้องแนบ \n ใน private key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# (ไม่บังคับ) ชื่อ Collection และ Document ใน Firestore
# FIREBASE_FIRESTORE_COLLECTION=classquest
# FIREBASE_FIRESTORE_DOC=db

# ===== อื่น ๆ =====
# ไม่มีตัวแปรสำหรับรหัสผ่านครู — ครูแต่ละคนสมัครเองที่ /teacher/login
# และรหัสผ่านถูกเก็บเป็น hash ในฐานข้อมูล ไม่ใช่ค่าที่ตั้งไว้ในไฟล์นี้
# เหตุผล: ค่าที่อยู่ใน env แปลว่าทุกคนที่เข้าถึงโปรเจกต์อ่านได้ และรหัสเดียวใช้ได้ทั้งระบบ
